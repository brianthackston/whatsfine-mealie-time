# Copy to .env (gitignored) and fill in. Brand settings come from
# ../brand/mealie.env; this file is the per-machine part.

# The URL people reach Mealie at. Links in emails and webhooks use it.
BASE_URL=https://recipes.whatsfine.com
TZ=America/New_York

# From Zero Trust → Networks → Tunnels → your tunnel → Install connector.
# Only needed with `--profile tunnel`.
TUNNEL_TOKEN=

# Optional: send mail (invites, password resets) through Resend's SMTP relay,
# the same sending domain whatsfine.com uses.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_AUTH_STRATEGY=TLS
# SMTP_FROM_NAME=WhatsFine
# SMTP_FROM_EMAIL=howdy@email.whatsfine.com
# SMTP_USER=resend
# SMTP_PASSWORD=
