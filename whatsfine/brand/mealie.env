# WhatsFine look for Mealie, entirely through upstream's own settings.
# Loaded by whatsfine/docker-compose.yml (env_file); reusable as-is on any
# host that takes environment variables.
#
# Colours come from the WhatsFine design tokens (whatsfine/src/styles/tokens.css).
# Vuetify derives its text-on-colour automatically, so sun gets ink text and
# forest gets cream text without any help from us.
#
# What each key reaches in Mealie's UI (frontend/app/plugins/theme.ts):
#   primary   app bar, primary buttons, active nav, the logo avatar
#   accent    links, highlights, secondary buttons
#   secondary a few chips and toggles
#   success / info / warning / error   alerts and status chips

# ── Identity ────────────────────────────────────────────────────────────
# Shown in the app bar and the browser tab title.
BRANDING_NAME=WhatsFine
# Path *inside the container*; docker-compose.yml mounts whatsfine/brand/mark.png there.
# Allowed types: svg png ico webp jpg jpeg. Used at 40px (app bar), 75px (login) and as favicon.
BRANDING_LOGO_PATH=/app/brand/mark.png

# ── Light (cream context) ───────────────────────────────────────────────
THEME_LIGHT_PRIMARY=#113939
THEME_LIGHT_ACCENT=#f0432b
THEME_LIGHT_SECONDARY=#ffc22e
THEME_LIGHT_SUCCESS=#1e8e5a
THEME_LIGHT_INFO=#1077b0
THEME_LIGHT_WARNING=#e29a00
THEME_LIGHT_ERROR=#c7301c

# ── Dark (forest context) ───────────────────────────────────────────────
# Mealie's dark surfaces are near-black, so the bar steps up to forest-600 for
# separation; the pop accents stay at full saturation, as on the site's .wf-dark.
THEME_DARK_PRIMARY=#1b4f4c
THEME_DARK_ACCENT=#f0432b
THEME_DARK_SECONDARY=#ffc22e
THEME_DARK_SUCCESS=#1e8e5a
THEME_DARK_INFO=#1b9ce0
THEME_DARK_WARNING=#ffc22e
THEME_DARK_ERROR=#f0432b
